---
// Tipografías alojadas en el propio sitio (licencia OFL): ninguna página descarga nada de otro dominio (RN-LET-01-18).
import '@fontsource/cinzel/latin-600.css';
import '@fontsource/cinzel/latin-700.css';
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-900.css';
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-600.css';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';

const { titulo, descripcion, actual = '', sinIndexar = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {sinIndexar && <meta name="robots" content="noindex" />}
    <slot name="cabeza" />
    <meta name="theme-color" content="#0A1430" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera actual={actual} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
