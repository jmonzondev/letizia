---
import Base from '../layouts/Base.astro';
---
<Base
  titulo="El Archivo de Talavera · La actualidad de nuestra tierra"
  descripcion="Lo que pasa en Talavera y su comarca, contado cada día. Hoy es noticia, mañana, Archivo."
  actual="/"
>
  <section class="heroe">
    <div class="contenedor">
      <p class="sobretitulo">La actualidad de nuestra tierra</p>
      <h1>Hoy es noticia.<br /><span class="oro">Mañana, Archivo.</span></h1>
      <span class="filete" aria-hidden="true"></span>
      <p class="entradilla">Lo que pasa en Talavera y su comarca, contado cada día.</p>
      <p class="acciones">
        <a class="boton boton-oro" href="/contacto/">Escríbenos</a>
        <a class="enlace-claro" href="/quienes-somos/">Conoce quiénes somos</a>
      </p>
    </div>
  </section>
  <section class="contenedor bloque">
    <h2>¿Ha pasado algo en tu barrio?</h2>
    <p>Cuéntanoslo. Si es noticia, la contamos. Escríbenos desde la página de contacto y te respondemos al correo que nos dejes.</p>
  </section>
</Base>
